# SaathiMart Production Environment Variables
# Copy to .env and fill in values

# Database
DB_PASSWORD=change-me-to-a-strong-password

# Webhook secret (same on hub and all vendors)
WEBHOOK_SECRET=change-me-to-a-random-64-char-string

# Salt for Frappe session
FRAPPE_SITE_NAME=saathimart.localhost

# SSL (for Let's Encrypt, or place certs in ./certs/)
# SSL_EMAIL=admin@yourdomain.com

# CDN (optional)
# CDN_BASE_URL=https://cdn.yourdomain.com

# Email (optional, for notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
