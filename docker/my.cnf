[mysqld]
# ── InnoDB (primary storage engine) ──────────────────────────────────────────
# Buffer pool = 40% of available RAM after OS + Frappe overhead
# On 4GB server: ~1.2GB for MariaDB, buffer_pool = 512MB
innodb_buffer_pool_size = 512M
innodb_buffer_pool_instances = 2
innodb_log_file_size = 128M
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = ON
innodb_io_capacity = 200
innodb_io_capacity_max = 400
innodb_read_io_threads = 4
innodb_write_io_threads = 4
innodb_buffer_pool_dump_at_shutdown = ON
innodb_buffer_pool_load_at_startup = ON

# ── Query Cache (Frappe uses this for page cache) ────────────────────────────
query_cache_type = 1
query_cache_size = 64M
query_cache_limit = 2M
query_cache_min_res_unit = 2K

# ── Connections ──────────────────────────────────────────────────────────────
max_connections = 100
thread_cache_size = 16
max_allowed_packet = 64M
wait_timeout = 600
interactive_timeout = 600

# ── Thread Pool (for concurrent requests) ────────────────────────────────────
thread_handling = pool-of-threads
thread_pool_size = 8
thread_pool_oversubmit = 2

# ── Table Cache ──────────────────────────────────────────────────────────────
table_open_cache = 4000
table_definition_cache = 2000
open_files_limit = 65535

# ── Sort / Join / Read buffers ───────────────────────────────────────────────
sort_buffer_size = 2M
join_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 1M
tmp_table_size = 64M
max_heap_table_size = 64M

# ── Slow Query Log (monitor performance) ─────────────────────────────────────
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 0.5
log_queries_not_using_indexes = 0

# ── Binary Logging (for replication if needed) ──────────────────────────────
# skip-log-bin  # Keep disabled for now — useful for point-in-time recovery

# ── Character Set ────────────────────────────────────────────────────────────
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[mysqldump]
quick
max_allowed_packet = 64M
