        {
          "name": "Set Customer Location",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.cart.set_customer_location",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"lat\": 27.7172,\n  \"lng\": 85.3240\n}" }
          },
          "response": []
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.cart.clear_cart",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checkout & Orders",
      "item": [
        {
          "name": "Calculate Cart Totals",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.calculate_cart_totals",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"coupon_code\": \"{{coupon_code}}\",\n  \"loyalty_points\": 0,\n  \"delivery_charges\": 0\n}" },
            "description": "Read-only preview of what checkout() would charge — same pipeline, no order created. Run Add To Cart first."
          },
          "response": []
        },
        {
          "name": "Checkout (place order from cart)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const msg = pm.response.json().message || {};",
              "  if (msg.order) pm.collectionVariables.set('order_id', msg.order);",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.checkout",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"customer_name\": \"Postman Tester\",\n  \"customer_mobile\": \"9800000001\",\n  \"customer_email\": \"{{test_email}}\",\n  \"delivery_address\": \"Thamel Marg, Ward 26\",\n  \"delivery_city\": \"Kathmandu\",\n  \"payment_mode\": \"COD\",\n  \"coupon_code\": \"{{coupon_code}}\"\n}" },
            "description": "Requires a non-empty cart under {{session_id}} (run Cart > Add To Cart first). payment_mode must be an existing Saathi Payment Mode name — COD/Bank Transfer/eSewa by default. On success, fills {{order_id}}."
          },
          "response": []
        },
        {
          "name": "Create Order (direct, no cart)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const msg = pm.response.json().message || {};",
              "  if (msg.order) pm.collectionVariables.set('order_id', msg.order);",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.create_order",
            "body": { "mode": "raw", "raw": "{\n  \"franchise\": \"{{franchise}}\",\n  \"payment_mode\": \"COD\",\n  \"customer_name\": \"Postman Tester\",\n  \"customer_mobile\": \"9800000001\",\n  \"customer_email\": \"{{test_email}}\",\n  \"delivery_address\": \"Thamel Marg, Ward 26\",\n  \"delivery_city\": \"Kathmandu\",\n  \"items\": [\n    { \"item_code\": \"{{item_code}}\", \"qty\": 1 }\n  ]\n}" },
            "description": "Alternate order-creation path that bypasses SM Cart entirely — items are passed directly. Rate-limited to 20/min. On success, fills {{order_id}}."
          },
          "response": []
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.get_order?order={{order_id}}"
          },
          "response": []
        },
        {
          "name": "Track Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.track_order?order_id={{order_id}}"
          },
          "response": []
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.list_orders?page=1&page_size=20"
          },
          "response": []
        },
        {
          "name": "Get Order Status (guest, by mobile)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.get_order_status?order={{order_id}}&customer_mobile=9800000001",
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Get Payment Modes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.get_payment_modes",
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Update Order Status (SM Admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.order.update_order_status",
            "body": { "mode": "raw", "raw": "{\n  \"order\": \"{{order_id}}\",\n  \"status\": \"Confirmed\"\n}" },
            "description": "Requires the logged-in user to have the SM Admin role. Valid transitions are enforced server-side (see api/constants.py VALID_ORDER_TRANSITIONS)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments (eSewa)",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.payments.initiate_payment",
            "body": { "mode": "raw", "raw": "{\n  \"order\": \"{{order_id}}\"\n}" },
            "description": "Order's payment_mode must be an is_online Saathi Payment Mode (eSewa). Returns the signed form fields + payment_url to POST the shopper's browser to — this endpoint alone does not charge anything."
          },
          "response": []
        },
        {
          "name": "Verify eSewa Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.payments.verify_esewa_status?order={{order_id}}",
            "description": "Polls eSewa's own transaction-status API directly — same check the 10-min cron (poll_pending_esewa_orders) runs for orders whose success/failure redirect never arrived."
          },
          "response": []
        }
      ]
    },
