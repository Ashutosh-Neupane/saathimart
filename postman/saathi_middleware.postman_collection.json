      "name": "Franchise Item Sync (franchise-authenticated)",
      "description": "Called by a franchise's own saathi_ecommerce site, not the storefront — auth is X-Saathi-Api-Key / X-Saathi-Api-Secret headers (a Franchise doc's api_key/api_secret), not the token auth the rest of this collection uses. Set {{franchise_api_key}} / {{franchise_api_secret}} before running these.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Sync Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Saathi-Api-Key", "value": "{{franchise_api_key}}" },
              { "key": "X-Saathi-Api-Secret", "value": "{{franchise_api_secret}}" }
            ],
            "url": "{{base_url}}/api/method/saathi_middleware.api.item.sync_item",
            "body": { "mode": "raw", "raw": "{\n  \"item_code\": \"{{item_code}}\",\n  \"item_name\": \"Mineral Water 1L\",\n  \"description\": \"Purified mineral water.\",\n  \"item_group\": \"Beverages\",\n  \"uom\": \"Nos\",\n  \"price\": 30,\n  \"stock_qty\": 150,\n  \"is_active\": 1,\n  \"pushed_at\": \"{{$isoTimestamp}}\"\n}" },
            "description": "docname becomes \"{authenticated franchise}-{item_code}\". A stale pushed_at (older than what's already stored) is silently skipped, not overwritten."
          },
          "response": []
        },
        {
          "name": "Bulk Sync Items",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Saathi-Api-Key", "value": "{{franchise_api_key}}" },
              { "key": "X-Saathi-Api-Secret", "value": "{{franchise_api_secret}}" }
            ],
            "url": "{{base_url}}/api/method/saathi_middleware.api.item.bulk_sync_items",
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"item_code\": \"BEV-001\", \"item_name\": \"Mineral Water 1L\", \"price\": 30, \"stock_qty\": 150, \"is_active\": 1 },\n    { \"item_code\": \"BEV-002\", \"item_name\": \"Cola 500ml\", \"price\": 65, \"stock_qty\": 100, \"is_active\": 1 }\n  ]\n}" }
          },
          "response": []
        },
        {
          "name": "Get Nearby Items",
