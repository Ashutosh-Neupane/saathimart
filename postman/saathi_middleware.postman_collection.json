{
  "info": {
    "name": "Saathi Middleware API",
    "description": "Full API surface for saathi_middleware — the SaathiMart hub backend (catalog, cart, checkout, payments, loyalty, coupons, CMS, franchise item sync). Every request here matches a real @frappe.whitelist function verified working during development.\n\nAuth: most customer-facing endpoints accept an optional `Authorization: token <api_key>:<api_secret>` header (Frappe token auth) set at the collection level from {{api_key}}/{{api_secret}} — run **Auth > Login** first, its test script fills those in automatically. Endpoints marked `allow_guest=True` work with no auth at all (guest cart/browsing).\n\nSet `base_url` and `host_header` in the environment to match your site (see README for the `saathi-mw.localhost` Docker-networking note if you're not on a real domain).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": [
        "if (pm.environment.get('host_header') || pm.collectionVariables.get('host_header')) {",
        "  pm.request.headers.upsert({ key: 'Host', value: pm.environment.get('host_header') || pm.collectionVariables.get('host_header') });",
        "}",
        "// Collection-level `auth` inheritance is unreliable under Newman for",
        "// requests that omit their own `auth` block, so set the token header",
        "// explicitly here instead — this is the actual source of truth.",
        "// Requests with their own noauth (guest-only demos) still send it",
        "// harmlessly, since allow_guest=True endpoints accept an authenticated",
        "// caller too (same as the real storefront frontend always attaching",
        "// its token once logged in, guest-eligible endpoint or not).",
        "const apiKey = pm.collectionVariables.get('api_key');",
        "const apiSecret = pm.collectionVariables.get('api_secret');",
        "if (apiKey && apiSecret) {",
        "  pm.request.headers.upsert({ key: 'Authorization', value: `token ${apiKey}:${apiSecret}` });",
        "}"
      ] }
    },
    {
      "listen": "test",
      "script": { "type": "text/javascript", "exec": [
        "pm.test('server did not 5xx', function () {",
        "  pm.expect(pm.response.code, pm.response.text()).to.be.below(500);",
        "});"
      ] }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://saathi-mw.localhost:8002" },
    { "key": "host_header", "value": "saathi-mw.localhost" },
    { "key": "api_key", "value": "" },
    { "key": "api_secret", "value": "" },
    { "key": "session_id", "value": "postman-session-{{$randomUUID}}" },
    { "key": "franchise", "value": "SM-DEMO" },
    { "key": "item_code", "value": "BEV-001" },
    { "key": "product_slug", "value": "SM-DEMO-BEV-001" },
    { "key": "order_id", "value": "" },
    { "key": "coupon_code", "value": "SAVE20" },
    { "key": "address_id", "value": "" },
    { "key": "test_email", "value": "postman-test@example.com" },
    { "key": "test_password", "value": "Postman@Test123" },
    { "key": "franchise_api_key", "value": "" },
    { "key": "franchise_api_secret", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/ping",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.signup",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"full_name\": \"Postman Tester\",\n  \"contact\": \"9800000001\",\n  \"password\": \"{{test_password}}\"\n}" },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Verify Signup OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.verify_signup_otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"123456\"\n}" },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.resend_otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"purpose\": \"signup\"\n}" },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  const msg = body.message || {};",
              "  if (msg.api_key) pm.collectionVariables.set('api_key', msg.api_key);",
              "  if (msg.api_secret) pm.collectionVariables.set('api_secret', msg.api_secret);",
              "  pm.test('got a token', function () { pm.expect(msg.token).to.be.a('string'); });",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.login",
            "body": { "mode": "raw", "raw": "{\n  \"usr\": \"{{test_email}}\",\n  \"pwd\": \"{{test_password}}\"\n}" },
            "auth": { "type": "noauth" },
            "description": "On success, fills in {{api_key}}/{{api_secret}} collection variables used by every other request's Authorization header."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.forgot_password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\"\n}" },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Verify Forgot-Password OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.verify_forgot_password_otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"123456\",\n  \"new_password\": \"{{test_password}}\"\n}" },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth_full.change_password",
            "body": { "mode": "raw", "raw": "{\n  \"old_password\": \"{{test_password}}\",\n  \"new_password\": \"{{test_password}}\"\n}" }
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth.get_profile"
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.auth.update_profile",
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Tester\",\n  \"phone\": \"9800000001\"\n}" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.catalog.list_categories",
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/saathi_middleware.api.catalog.list_products?page=1&page_size=20&in_stock=1",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "saathi_middleware.api.catalog.list_products"],
              "query": [
                { "key": "category", "value": "beverages", "disabled": true },
                { "key": "search", "value": "milk", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "sort", "value": "price_asc", "disabled": true },
                { "key": "in_stock", "value": "1" },
                { "key": "min_price", "value": "0", "disabled": true },
                { "key": "max_price", "value": "1000", "disabled": true },
                { "key": "lat", "value": "27.7172", "disabled": true },
                { "key": "lng", "value": "85.3240", "disabled": true }
              ]
            },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.catalog.get_product?slug={{product_slug}}",
            "auth": { "type": "noauth" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.cart.add_to_cart",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"item_code\": \"{{item_code}}\",\n  \"franchise\": \"{{franchise}}\",\n  \"qty\": 1\n}" }
          },
          "response": []
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.cart.update_cart_item",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"item_code\": \"{{item_code}}\",\n  \"franchise\": \"{{franchise}}\",\n  \"qty\": 2\n}" }
          },
          "response": []
        },
        {
          "name": "Get Cart Summary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.cart.get_cart_summary",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}" }
          },
          "response": []
        },
        {
          "name": "Get Cart (full doc)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/method/saathi_middleware.api.cart.get_cart",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}" }
          },
          "response": []
