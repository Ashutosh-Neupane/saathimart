    {
      "name": "Addresses",
      "item": [
        {
          "name": "List Addresses",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/method/saathi_middleware.api.addresses.list_addresses"
          },
          "response": []
        },
        {
          "name": "Add Address",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const msg = pm.response.json().message || {};",
              "  if (msg.name) pm.collectionVariables.set('address_id', msg.name);",
              "}"
            ] }
