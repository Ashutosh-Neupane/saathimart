{
  "name": "Payment Log",
  "module": "Saathi Middleware",
  "doctype": "DocType",
  "autoname": "SM-PAY-.YYYY.-.#####",
  "track_changes": 0,
  "fields": [
   {"fieldname": "order", "fieldtype": "Link", "label": "Order", "options": "Saathi Order", "reqd": 1, "in_list_view": 1},
   {"fieldname": "gateway", "fieldtype": "Select", "label": "Gateway",
    "options": "eSewa\nCOD", "in_list_view": 1},
   {"fieldname": "status", "fieldtype": "Select", "label": "Status",
    "options": "Success\nFailed\nPending", "default": "Pending", "in_list_view": 1},
   {"fieldname": "col_break_1", "fieldtype": "Column Break"},
   {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "in_list_view": 1},
   {"fieldname": "reference", "fieldtype": "Data", "label": "Gateway Reference"},
   {"fieldname": "transaction_uid", "fieldtype": "Data", "label": "Transaction UUID"},
   {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
   {"role": "SM Admin", "read": 1, "write": 1, "create": 1}
  ]
}
