{
  "openapi": "3.0.3",
  "info": {
    "title": "SaathiMart API",
    "description": "Central commerce hub API — Blinkit-style, Frappe-native, multi-vendor marketplace.\n\nAll endpoints are accessed via POST to `/api/method/saathimart.api.<module>.<function>`.\n\n## Authentication\n- **Guest**: allow_guest=True endpoints work without login (rate-limited)\n- **Session**: Frappe session cookie for web clients\n- **API Key**: `Authorization: token api_key:api_secret` for server-to-server\n- **HMAC Signature**: `X-SM-Signature` + `X-SM-Timestamp` for vendor webhooks\n\n## Rate Limiting\nGuest endpoints are rate-limited by IP (configurable per endpoint, default 60-300 req/min).\n\n## Error Responses\nAll endpoints return `{\"ok\": false, \"error\": \"...\", \"error_code\": \"...\"}` on failure.",
    "version": "0.1.0",
    "contact": {
      "name": "Trevo Cloud Nepal",
      "email": "dev@trevo.com.np"
    }
  },
  "servers": [
    {"url": "https://saathimart.example.com", "description": "Production"},
    {"url": "http://localhost:8000", "description": "Local dev / Docker"}
  ],
  "tags": [
    {"name": "Products", "description": "Product catalogue, listing, variants, templates"},
    {"name": "Cart", "description": "Shopping cart management, offline sync"},
    {"name": "Orders", "description": "Order creation, tracking, history"},
    {"name": "Payments", "description": "eSewa integration, payment initiation & verification"},
    {"name": "Auth", "description": "Login, signup, OTP, session management"},
    {"name": "CMS", "description": "Banners, pages, FAQs, offers, navigation"},
    {"name": "Home", "description": "Homepage data, rails, deals, bestsellers"},
    {"name": "Search", "description": "Full-text search, autocomplete, filters"},
    {"name": "Location", "description": "Delivery zones, customer location, franchise selection"},
    {"name": "Delivery", "description": "Delivery charges, zone calculation"},
    {"name": "Addresses", "description": "Customer saved addresses"},
    {"name": "Reviews", "description": "Product reviews and ratings"},
    {"name": "Wishlist", "description": "Customer wishlist management"},
    {"name": "Loyalty", "description": "Loyalty points, tiers, programs"},
    {"name": "Membership", "description": "Membership plans, benefits, savings"},
    {"name": "Coupons", "description": "Coupon validation and redemption"},
    {"name": "Mobile", "description": "Mobile-optimized lightweight endpoints"},
    {"name": "Push Notifications", "description": "FCM device registration, notification sending"},
    {"name": "Analytics", "description": "Vendor and hub analytics dashboards"},
    {"name": "Admin Products", "description": "Admin CRUD for products, variants, vendor listings"},
    {"name": "Stock", "description": "Vendor stock management, reservations, snapshots"},
    {"name": "Vendor Management", "description": "Vendor onboarding, performance, payouts"},
    {"name": "Warehouses", "description": "Multi-warehouse management per vendor"},
    {"name": "Health", "description": "System health, deep health, sync monitoring"},
    {"name": "Settings", "description": "SaathiMart settings management"},
    {"name": "Totals", "description": "Cart/order total calculation"},
    {"name": "Events", "description": "Webhook event system, delivery, HMAC verification"},
    {"name": "Secret Rotation", "description": "Webhook secret rotation for vendor security"},
    {"name": "Filters", "description": "Available filter options for product browsing"},
    {"name": "Vendors (Public)", "description": "Public vendor info for storefront"},
    {"name": "Payouts", "description": "Vendor payout management"}
  ],
  "paths": {
    "/api/method/saathimart.api.products.list_products": {
      "post": {
        "tags": ["Products"],
        "summary": "List products with filters and sorting",
        "description": "Blinkit-style product listing. Supports category, brand, price range, in-stock, tags, and location-aware vendor filtering.",
        "operationId": "listProducts",
        "x-whitelist": "allow_guest=true",
        "parameters": [
          {"name": "category", "in": "query", "schema": {"type": "string"}, "description": "Category slug or comma-separated slugs"},
          {"name": "vendor", "in": "query", "schema": {"type": "string"}, "description": "Vendor name to filter by"},
          {"name": "search", "in": "query", "schema": {"type": "string"}, "description": "Search term (matches name, tags, description)"},
          {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "default": 20, "maximum": 100}},
          {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["price_asc", "price_desc", "newest", "popularity", "rating"]}},
          {"name": "in_stock", "in": "query", "schema": {"type": "boolean"}},
          {"name": "min_price", "in": "query", "schema": {"type": "number"}},
          {"name": "max_price", "in": "query", "schema": {"type": "number"}},
          {"name": "tags", "in": "query", "schema": {"type": "string"}, "description": "Comma-separated tags"},
          {"name": "brand", "in": "query", "schema": {"type": "string"}},
          {"name": "delivery_zone", "in": "query", "schema": {"type": "string"}},
          {"name": "lat", "in": "query", "schema": {"type": "number"}},
          {"name": "lng", "in": "query", "schema": {"type": "number"}},
          {"name": "radius_km", "in": "query", "schema": {"type": "number", "default": 5}}
        ],
        "responses": {
          "200": {
            "description": "Product list",
            "content": {"application/json": {"schema": {"type": "object", "properties": {
              "products": {"type": "array", "items": {"$ref": "#/components/schemas/ProductListItem"}},
              "total": {"type": "integer"},
              "page": {"type": "integer"},
              "page_size": {"type": "integer"},
              "has_next": {"type": "boolean"}
            }}}}
          }
        }
      }
    },
    "/api/method/saathimart.api.products.get_product": {
      "post": {
        "tags": ["Products"],
        "summary": "Get full product detail",
        "description": "Returns complete product with vendor listings, variants, reviews, and related products. Supports ETag/If-None-Match for caching.",
        "operationId": "getProduct",
        "x-whitelist": "allow_guest=true",
        "parameters": [
          {"name": "slug", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "vendor", "in": "query", "schema": {"type": "string"}},
          {"name": "delivery_zone", "in": "query", "schema": {"type": "string"}},
          {"name": "lat", "in": "query", "schema": {"type": "number"}},
          {"name": "lng", "in": "query", "schema": {"type": "number"}},
          {"name": "radius_km", "in": "query", "schema": {"type": "number", "default": 5}}
        ],
        "responses": {
          "200": {"description": "Product detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProductDetail"}}},
          "304": {"description": "Not Modified (ETag match)"}
          }
        }
      }
    },
