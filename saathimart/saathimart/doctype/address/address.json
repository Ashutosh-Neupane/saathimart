  {"fieldname": "street_address", "fieldtype": "Small Text", "label": "Street Address", "reqd": 1},
  {"fieldname": "landmark", "fieldtype": "Data", "label": "Landmark"},
  {"fieldname": "col_break_2", "fieldtype": "Column Break"},
