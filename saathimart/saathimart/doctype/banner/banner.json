 "field_order": [
  "title",
  "banner_type",
  "is_active",
  "col_break_1",
  "sort_order",
  "valid_from",
  "valid_to",
  "section_content",
  "heading",
  "subheading",
  "cta_label",
  "cta_url",
  "cta_secondary_label",
  "cta_secondary_url",
  "col_break_2",
  "image",
  "mobile_image",
  "bg_color",
  "text_color"
 ],
