{
 "name": "Banner",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-BNR-.#####",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "banner_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Hero\nPromo Strip\nCategory\nProduct\nCustom",
   "default": "Hero",
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Is Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Sort Order",
   "default": "0"
  },
  {
   "fieldname": "valid_from",
   "fieldtype": "Date",
   "label": "Valid From"
  },
  {
   "fieldname": "valid_to",
   "fieldtype": "Date",
   "label": "Valid To"
  },
  {
   "fieldname": "section_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "fieldname": "heading",
   "fieldtype": "Small Text",
   "label": "Heading",
   "description": "One line per line-break for a multi-line hero title, e.g. \"Celebrate Dashain with\\nLove and Togetherness\""
  },
  {
   "fieldname": "subheading",
   "fieldtype": "Small Text",
   "label": "Subheading"
  },
  {
   "fieldname": "cta_label",
   "fieldtype": "Data",
   "label": "CTA Label"
  },
  {
   "fieldname": "cta_url",
   "fieldtype": "Data",
   "label": "CTA URL"
  },
  {
   "fieldname": "cta_secondary_label",
   "fieldtype": "Data",
   "label": "Secondary CTA Label"
  },
  {
   "fieldname": "cta_secondary_url",
   "fieldtype": "Data",
   "label": "Secondary CTA URL"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "image",
   "fieldtype": "Attach Image",
   "label": "Desktop Image"
  },
  {
   "fieldname": "mobile_image",
   "fieldtype": "Attach Image",
   "label": "Mobile Image"
  },
  {
   "fieldname": "bg_color",
   "fieldtype": "Color",
   "label": "Background Color"
  },
  {
   "fieldname": "text_color",
   "fieldtype": "Color",
   "label": "Text Color"
  }
 ],
 "title_field": "title",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Guest",
   "read": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
