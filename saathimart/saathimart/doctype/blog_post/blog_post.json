{
 "name": "Blog Post",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-BLOG-.YYYY.-.#####",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "slug",
   "fieldtype": "Data",
   "label": "Slug",
   "unique": 1
  },
  {
   "fieldname": "author",
   "fieldtype": "Data",
   "label": "Author"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPublished\nArchived",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "published_at",
   "fieldtype": "Datetime",
   "label": "Published At"
  },
  {
   "fieldname": "category",
   "fieldtype": "Data",
   "label": "Category"
  },
  {
   "fieldname": "tags",
   "fieldtype": "Data",
   "label": "Tags (comma separated)"
  },
  {
   "fieldname": "section_media",
   "fieldtype": "Section Break",
   "label": "\ud83d\uddbc\ufe0f Media"
  },
  {
   "fieldname": "cover_image",
   "fieldtype": "Attach Image",
   "label": "Cover Image"
  },
  {
   "fieldname": "excerpt",
   "fieldtype": "Small Text",
   "label": "Excerpt"
  },
  {
   "fieldname": "section_body",
   "fieldtype": "Section Break",
   "label": "\ud83d\udcdd Content"
  },
  {
   "fieldname": "content",
   "fieldtype": "Text Editor",
   "label": "Content"
  },
  {
   "fieldname": "section_seo",
   "fieldtype": "Section Break",
   "label": "\ud83d\udd0d SEO"
  },
  {
   "fieldname": "meta_title",
   "fieldtype": "Data",
   "label": "Meta Title"
  },
  {
   "fieldname": "meta_description",
   "fieldtype": "Small Text",
   "label": "Meta Description"
  },
  {
   "fieldname": "tab_connections",
   "fieldtype": "Tab Break",
   "label": "Connections",
   "show_dashboard": 1
  },
  {
   "fieldname": "tab_content",
   "fieldtype": "Tab Break",
   "label": "Content"
  },
  {
   "fieldname": "tab_seo",
   "fieldtype": "Tab Break",
   "label": "SEO"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  }
 ],
 "title_field": "title",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Guest",
   "read": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [],
 "states": [],
 "naming_rule": "Expression (old style)",
 "field_order": [
  "title",
  "slug",
  "author",
  "col_break_1",
  "status",
  "published_at",
  "col_break_2",
  "category",
  "tags",
  "tab_content",
  "section_media",
  "cover_image",
  "excerpt",
  "section_body",
  "content",
  "tab_seo",
  "section_seo",
  "meta_title",
  "meta_description",
  "tab_connections"
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}