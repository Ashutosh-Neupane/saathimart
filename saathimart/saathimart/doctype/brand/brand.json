{
 "name": "Brand",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "field:brand_name",
 "naming_rule": "By fieldname",
 "track_changes": 1,
 "fields": [
  {"fieldname": "brand_name", "fieldtype": "Data", "label": "Brand Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "unique": 1, "in_list_view": 1,
   "description": "URL-safe key, e.g. 'nestle'. Used by the storefront for brand filtering."},
  {"fieldname": "col_break_meta", "fieldtype": "Column Break"},
  {"fieldname": "logo", "fieldtype": "Attach Image", "label": "Logo",
   "description": "Brand logo shown in the filter sidebar."},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0", "in_list_view": 1},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": "1", "in_list_view": 1}
 ],
 "title_field": "brand_name",
 "search_fields": "brand_name,slug",
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "SM Vendor", "read": 1},
  {"role": "Guest", "read": 1}
 ]
}
