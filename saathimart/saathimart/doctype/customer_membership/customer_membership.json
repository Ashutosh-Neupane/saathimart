{
 "name": "Customer Membership",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-MEM-.YYYY.-.#####",
 "fields": [
  {"fieldname": "customer_email", "fieldtype": "Data", "label": "Customer Email", "options": "Email",
   "reqd": 1, "in_list_view": 1, "search_index": 1},
  {"fieldname": "plan", "fieldtype": "Link", "label": "Plan", "options": "Membership Plan",
   "reqd": 1, "in_list_view": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status",
   "options": "Active\nExpired\nCancelled", "default": "Active", "reqd": 1, "in_list_view": 1,
   "search_index": 1},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
  {"fieldname": "started_on", "fieldtype": "Date", "label": "Started On", "reqd": 1},
  {"fieldname": "expires_on", "fieldtype": "Date", "label": "Expires On", "reqd": 1,
   "in_list_view": 1, "search_index": 1},
  {"fieldname": "auto_renew", "fieldtype": "Check", "label": "Auto Renew", "default": "0"},
  {"fieldname": "section_purchase", "fieldtype": "Section Break", "label": "Purchase"},
  {"fieldname": "order", "fieldtype": "Link", "label": "Purchased Via Order", "options": "Order",
   "description": "The order that paid for this membership"},
  {"fieldname": "amount_paid", "fieldtype": "Currency", "label": "Amount Paid", "read_only": 1},
  {"fieldname": "col_break_2", "fieldtype": "Column Break"},
  {"fieldname": "total_saved", "fieldtype": "Currency", "label": "Total Saved", "read_only": 1, "default": "0",
   "description": "Rolled up from Membership Saving Entry — what this membership has returned so far"},
  {"fieldname": "remarks", "fieldtype": "Small Text", "label": "Remarks"}
 ],
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
 ]
}
