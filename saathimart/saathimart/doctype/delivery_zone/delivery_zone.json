  {"fieldname": "city", "fieldtype": "Data", "label": "City"},
  {"fieldname": "districts", "fieldtype": "Small Text", "label": "Districts (comma separated)"},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
