{
 "name": "FAQ Category",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-FAQCAT-.#####",
 "fields": [
  {"fieldname": "category_name", "fieldtype": "Data", "label": "Category Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "unique": 1, "reqd": 1, "in_list_view": 1,
   "description": "URL-safe key, e.g. 'delivery'. Used by the storefront for React keys and filtering."},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Description",
   "description": "Optional short description shown under the category heading."},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0", "in_list_view": 1},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": "1", "in_list_view": 1}
 ],
 "title_field": "category_name",
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Guest", "read": 1}
 ]
}
