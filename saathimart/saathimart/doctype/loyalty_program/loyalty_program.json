{
 "name": "Loyalty Program",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "field:program_name",
 "fields": [
  {
   "fieldname": "program_name",
   "fieldtype": "Data",
   "label": "Program Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Is Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "collection_factor",
   "fieldtype": "Float",
   "label": "Points Earned per NPR Spent",
   "default": "0.01",
   "description": "e.g. 0.01 = 1 point per NPR 100 spent"
  },
  {
   "fieldname": "redemption_factor",
   "fieldtype": "Float",
   "label": "NPR Value per Point",
   "default": "1",
   "description": "e.g. 1 = 1 point = NPR 1 discount"
  },
  {
   "fieldname": "section_limits",
   "fieldtype": "Section Break",
   "label": "Limits"
  },
  {
   "fieldname": "min_points_to_redeem",
   "fieldtype": "Int",
   "label": "Min Points to Redeem",
   "default": "100"
  },
  {
   "fieldname": "max_redemption_per_order_pct",
   "fieldtype": "Float",
   "label": "Max Redemption per Order (%)",
   "default": "20",
   "description": "Max % of order total that can be paid with points"
  },
  {
   "fieldname": "point_expiry_days",
   "fieldtype": "Int",
   "label": "Points Expire After (days, 0 = never)",
   "default": "365"
  },
  {
   "fieldname": "section_tiers",
   "fieldtype": "Section Break",
   "label": "Tiers"
  },
  {
   "fieldname": "tiers",
   "fieldtype": "Table",
   "label": "Tiers",
   "options": "Loyalty Tier"
  }
 ],
 "title_field": "program_name",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [],
 "states": [],
 "naming_rule": "Expression (old style)",
 "field_order": [
  "program_name",
  "is_active",
  "col_break_1",
  "collection_factor",
  "redemption_factor",
  "section_limits",
  "min_points_to_redeem",
  "max_redemption_per_order_pct",
  "point_expiry_days",
  "section_tiers",
  "tiers"
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 0
}