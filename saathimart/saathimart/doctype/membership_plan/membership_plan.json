{
 "name": "Membership Plan",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "field:plan_name",
 "fields": [
  {"fieldname": "plan_name", "fieldtype": "Data", "label": "Plan Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": "1", "in_list_view": 1},
  {"fieldname": "tagline", "fieldtype": "Data", "label": "Tagline",
   "description": "Short line shown on the plan card, e.g. 'Save on every vegetable order'"},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
  {"fieldname": "price", "fieldtype": "Currency", "label": "Price", "reqd": 1, "in_list_view": 1},
  {"fieldname": "duration_days", "fieldtype": "Int", "label": "Duration (days)", "default": "365", "reqd": 1},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0"},
  {"fieldname": "section_delivery", "fieldtype": "Section Break", "label": "Delivery Perk"},
  {"fieldname": "free_delivery", "fieldtype": "Check", "label": "Free Delivery",
   "description": "Delivery charge is waived, not discounted — it is not part of the benefit rules below"},
  {"fieldname": "free_delivery_min_order", "fieldtype": "Currency", "label": "Free Delivery Above",
   "depends_on": "free_delivery", "default": "0",
   "description": "0 = free delivery on every order"},
  {"fieldname": "section_benefits", "fieldtype": "Section Break", "label": "Discount Rules",
   "description": "Each row is one rule. A cart line matches at most one rule — the active one with the lowest priority."},
  {"fieldname": "benefits", "fieldtype": "Table", "label": "Benefits", "options": "Membership Benefit"},
  {"fieldname": "section_caps", "fieldtype": "Section Break", "label": "Plan-wide Cap"},
  {"fieldname": "max_discount_per_order", "fieldtype": "Currency", "label": "Max Discount Per Order", "default": "0",
   "description": "Ceiling across all rules combined. 0 = no cap."}
 ],
 "title_field": "plan_name",
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
 ]
}
