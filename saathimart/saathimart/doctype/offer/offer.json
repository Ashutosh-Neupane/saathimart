{
 "name": "Offer",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-OFFER-.#####",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "slug",
   "fieldtype": "Data",
   "label": "Slug",
   "unique": 1,
   "reqd": 1,
   "in_list_view": 1,
   "description": "URL-safe key, e.g. 'dashain-2026'. Used in /offers/{slug} routing."
  },
  {
   "fieldname": "subtitle",
   "fieldtype": "Data",
   "label": "Subtitle"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPublished\nArchived",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Is Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Sort Order",
   "default": "0"
  },
  {
   "fieldname": "section_dates",
   "fieldtype": "Section Break",
   "label": "Validity"
  },
  {
   "fieldname": "valid_from",
   "fieldtype": "Date",
   "label": "Valid From"
  },
  {
   "fieldname": "valid_to",
   "fieldtype": "Date",
   "label": "Valid To"
  },
  {
   "fieldname": "section_media",
   "fieldtype": "Section Break",
   "label": "Media"
  },
  {
   "fieldname": "image",
   "fieldtype": "Attach Image",
   "label": "Offer Image"
  },
  {
   "fieldname": "mobile_image",
   "fieldtype": "Attach Image",
   "label": "Mobile Image"
  },
  {
   "fieldname": "section_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description"
  },
  {
   "fieldname": "section_highlights",
   "fieldtype": "Section Break",
   "label": "Highlights"
  },
  {
   "fieldname": "highlights",
   "fieldtype": "Small Text",
   "label": "Highlights (one per line)",
   "description": "Each line becomes a bullet point in the offer card."
  },
  {
   "fieldname": "section_terms",
   "fieldtype": "Section Break",
   "label": "Terms & Conditions"
  },
  {
   "fieldname": "terms",
   "fieldtype": "Text Editor",
   "label": "Terms & Conditions"
  },
  {
   "fieldname": "section_seo",
   "fieldtype": "Section Break",
   "label": "SEO"
  },
  {
   "fieldname": "meta_title",
   "fieldtype": "Data",
   "label": "Meta Title"
  },
  {
   "fieldname": "meta_description",
   "fieldtype": "Small Text",
   "label": "Meta Description"
  }
 ],
 "title_field": "title",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Guest",
   "read": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [],
 "states": [],
 "naming_rule": "Expression (old style)",
 "field_order": [
  "title",
  "slug",
  "subtitle",
  "col_break_1",
  "status",
  "is_active",
  "sort_order",
  "section_dates",
  "valid_from",
  "valid_to",
  "section_media",
  "image",
  "mobile_image",
  "section_content",
  "description",
  "section_highlights",
  "highlights",
  "section_terms",
  "terms",
  "section_seo",
  "meta_title",
  "meta_description"
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}