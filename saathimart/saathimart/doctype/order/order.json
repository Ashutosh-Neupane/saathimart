{
 "name": "Order",
 "module": "Saathimart",
 "doctype": "DocType",
 "track_changes": 1,
 "autoname": "SM-ORD-.YYYY.-.#####",
 "fields": [
  {"fieldname": "customer_name", "fieldtype": "Data", "label": "Customer Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "customer_email", "fieldtype": "Data", "label": "Customer Email", "options": "Email"},
  {"fieldname": "customer_phone", "fieldtype": "Data", "label": "Customer Phone"},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status",
   "options": "Pending\nConfirmed\nPreparing\nOut for Delivery\nDelivered\nCancelled\nRefunded",
   "default": "Pending", "in_list_view": 1},
  {"fieldname": "payment_status", "fieldtype": "Select", "label": "Payment Status",
   "options": "Unpaid\nPaid\nPartially Paid\nRefunded", "default": "Unpaid"},
  {"fieldname": "payment_method", "fieldtype": "Select", "label": "Payment Method",
   "options": "COD\neSewa\nBank Transfer"},
   {"fieldname": "section_items", "fieldtype": "Section Break", "label": "Items"},
   {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "Order Item", "reqd": 1},
   {"fieldname": "section_fulfillments", "fieldtype": "Section Break", "label": "Vendor Fulfillments"},
   {"fieldname": "vendor_fulfillments", "fieldtype": "Table", "label": "Vendor Fulfillments", "options": "Vendor Fulfillment"},
   {"fieldname": "section_amounts", "fieldtype": "Section Break", "label": "Amounts"},
  {"fieldname": "subtotal", "fieldtype": "Currency", "label": "Subtotal", "read_only": 1},
  {"fieldname": "net_total", "fieldtype": "Currency", "label": "Net Total", "read_only": 1},
  {"fieldname": "taxes", "fieldtype": "Table", "label": "Taxes", "options": "Order Tax"},
  {"fieldname": "total_taxes", "fieldtype": "Currency", "label": "Total Taxes", "read_only": 1},
  {"fieldname": "delivery_charge", "fieldtype": "Currency", "label": "Delivery Charge", "default": "0"},
  {"fieldname": "free_delivery", "fieldtype": "Check", "label": "Free Delivery", "read_only": 1, "default": "0"},
  {"fieldname": "discount_amount", "fieldtype": "Currency", "label": "Discount", "default": "0"},
  {"fieldname": "total_discount", "fieldtype": "Currency", "label": "Total Discount", "read_only": 1},
  {"fieldname": "col_break_2", "fieldtype": "Column Break"},
  {"fieldname": "grand_total", "fieldtype": "Currency", "label": "Grand Total", "read_only": 1},
  {"fieldname": "section_delivery", "fieldtype": "Section Break", "label": "Delivery"},
  {"fieldname": "delivery_zone", "fieldtype": "Link", "label": "Delivery Zone", "options": "Delivery Zone"},
  {"fieldname": "delivery_address", "fieldtype": "Small Text", "label": "Delivery Address"},
  {"fieldname": "delivery_lat", "fieldtype": "Float", "label": "Latitude"},
  {"fieldname": "delivery_lng", "fieldtype": "Float", "label": "Longitude"},
  {"fieldname": "section_vendor", "fieldtype": "Section Break", "label": "Vendor"},
  {"fieldname": "vendor", "fieldtype": "Link", "label": "Vendor", "options": "Vendor"},
  {"fieldname": "vendor_order_id", "fieldtype": "Data", "label": "Vendor Order ID"},
  {"fieldname": "section_meta", "fieldtype": "Section Break", "label": "Meta"},
  {"fieldname": "source_site", "fieldtype": "Data", "label": "Source Site"},
  {"fieldname": "cart_id", "fieldtype": "Data", "label": "Cart ID"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"},
  {"fieldname": "section_payment_detail", "fieldtype": "Section Break", "label": "Payment Detail"},
  {"fieldname": "payment_reference", "fieldtype": "Data", "label": "Payment Reference"},
  {"fieldname": "esewa_transaction_uid", "fieldtype": "Data", "label": "eSewa Transaction UID"},
  {"fieldname": "section_loyalty", "fieldtype": "Section Break", "label": "Loyalty Points"},
  {"fieldname": "loyalty_points_redeemed", "fieldtype": "Float", "label": "Points Redeemed", "default": "0"},
  {"fieldname": "loyalty_discount", "fieldtype": "Currency", "label": "Loyalty Discount", "default": "0", "read_only": 1},
  {"fieldname": "col_break_loyalty", "fieldtype": "Column Break"},
  {"fieldname": "loyalty_points_earned", "fieldtype": "Float", "label": "Points Earned", "default": "0", "read_only": 1},
  {"fieldname": "coupon_code", "fieldtype": "Data", "label": "Coupon Code"},
  {"fieldname": "coupon_discount", "fieldtype": "Currency", "label": "Coupon Discount", "default": "0", "read_only": 1},
  {"fieldname": "onboarding_discount", "fieldtype": "Currency", "label": "Onboarding Discount", "default": "0", "read_only": 1,
   "description": "Auto-applied first/second-order discount from the delivery zone's onboarding rates — see Delivery Zone.first_order_discount_pct"},
  {"fieldname": "onboarding_order_sequence", "fieldtype": "Int", "label": "Onboarding Order Sequence", "default": "0", "read_only": 1,
   "description": "1 = this customer's first order, 2 = second, 0 = not eligible / not computed. Recorded for audit even when the discount was 0."}
 ],
 "search_fields": "customer_name,customer_email,customer_phone",
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "SM Vendor", "read": 1, "write": 1},
  {"role": "SM Customer", "read": 1, "create": 1}
 ]
}
