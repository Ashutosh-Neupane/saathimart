{
 "name": "Order",
 "module": "Saathimart",
 "doctype": "DocType",
 "track_changes": 1,
 "autoname": "SM-ORD-.YYYY.-.#####",
 "fields": [
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "label": "Customer Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer_email",
   "fieldtype": "Data",
   "label": "Customer Email",
   "options": "Email"
  },
  {
   "fieldname": "customer_phone",
   "fieldtype": "Data",
   "label": "Customer Phone"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending\nConfirmed\nPreparing\nOut for Delivery\nDelivered\nCancelled\nRefunded",
   "default": "Pending",
   "in_list_view": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Unpaid\nPaid\nPartially Paid\nRefunded",
   "default": "Unpaid"
  },
  {
   "fieldname": "payment_method",
   "fieldtype": "Select",
   "label": "Payment Method",
   "options": "COD\neSewa\nBank Transfer"
  },
  {
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Order Item",
   "reqd": 1
  },
  {
   "fieldname": "section_fulfillments",
   "fieldtype": "Section Break",
   "label": "Vendor Fulfillments"
  },
  {
   "fieldname": "vendor_fulfillments",
   "fieldtype": "Table",
   "label": "Vendor Fulfillments",
   "options": "Vendor Fulfillment"
  },
  {
   "fieldname": "section_amounts",
   "fieldtype": "Section Break",
   "label": "Amounts"
  },
  {
   "fieldname": "subtotal",
   "fieldtype": "Currency",
   "label": "Subtotal",
   "read_only": 1
  },
  {
   "fieldname": "net_total",
   "fieldtype": "Currency",
   "label": "Net Total",
   "read_only": 1
  },
  {
   "fieldname": "taxes",
   "fieldtype": "Table",
   "label": "Taxes",
   "options": "Order Tax"
  },
  {
   "fieldname": "total_taxes",
   "fieldtype": "Currency",
   "label": "Total Taxes",
   "read_only": 1
  },
  {
   "fieldname": "delivery_charge",
   "fieldtype": "Currency",
   "label": "Delivery Charge",
   "default": "0"
  },
  {
   "fieldname": "free_delivery",
   "fieldtype": "Check",
   "label": "Free Delivery",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "discount_amount",
   "fieldtype": "Currency",
   "label": "Discount",
   "default": "0"
  },
  {
   "fieldname": "total_discount",
   "fieldtype": "Currency",
   "label": "Total Discount",
   "read_only": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "grand_total",
   "fieldtype": "Currency",
   "label": "Grand Total",
   "read_only": 1
  },
  {
   "fieldname": "section_delivery",
   "fieldtype": "Section Break",
   "label": "Delivery"
  },
  {
   "fieldname": "delivery_zone",
   "fieldtype": "Link",
   "label": "Delivery Zone",
   "options": "Delivery Zone"
  },
  {
   "fieldname": "delivery_address",
   "fieldtype": "Small Text",
   "label": "Delivery Address"
  },
  {
   "fieldname": "delivery_lat",
   "fieldtype": "Float",
   "label": "Latitude"
  },
  {
   "fieldname": "delivery_lng",
   "fieldtype": "Float",
   "label": "Longitude"
  },
  {
   "fieldname": "section_vendor",
   "fieldtype": "Section Break",
   "label": "Vendor"
  },
  {
   "fieldname": "vendor",
   "fieldtype": "Link",
   "label": "Vendor",
   "options": "Vendor"
  },
  {
   "fieldname": "vendor_order_id",
   "fieldtype": "Data",
   "label": "Vendor Order ID"
  },
  {
   "fieldname": "section_meta",
   "fieldtype": "Section Break",
   "label": "Meta"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "section_payment_detail",
   "fieldtype": "Section Break",
   "label": "Payment Detail"
  },
  {
   "fieldname": "payment_reference",
   "fieldtype": "Data",
   "label": "Payment Reference"
  },
  {
   "fieldname": "esewa_transaction_uid",
   "fieldtype": "Data",
   "label": "eSewa Transaction UID"
  },
  {
   "fieldname": "section_loyalty",
   "fieldtype": "Section Break",
   "label": "Loyalty Points"
  },
  {
   "fieldname": "loyalty_points_redeemed",
   "fieldtype": "Float",
   "label": "Points Redeemed",
   "default": "0"
  },
  {
   "fieldname": "loyalty_discount",
   "fieldtype": "Currency",
   "label": "Loyalty Discount",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "col_break_loyalty",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "loyalty_points_earned",
   "fieldtype": "Float",
   "label": "Points Earned",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "coupon_code",
   "fieldtype": "Data",
   "label": "Coupon Code"
  },
  {
   "fieldname": "coupon_discount",
   "fieldtype": "Currency",
   "label": "Coupon Discount",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "onboarding_discount",
   "fieldtype": "Currency",
   "label": "Onboarding Discount",
   "default": "0",
   "read_only": 1,
   "description": "Auto-applied first/second-order discount from the delivery zone's onboarding rates — see Delivery Zone.first_order_discount_pct"
  },
  {
   "fieldname": "onboarding_order_sequence",
   "fieldtype": "Int",
   "label": "Onboarding Order Sequence",
   "default": "0",
   "read_only": 1,
   "description": "1 = this customer's first order, 2 = second, 0 = not eligible / not computed. Recorded for audit even when the discount was 0."
  },
  {
   "fieldname": "membership",
   "fieldtype": "Link",
   "label": "Membership",
   "options": "Customer Membership",
   "read_only": 1,
   "description": "The membership that was active when this order was priced. Recorded so a later plan edit can't change what this order says it gave."
  },
  {
   "fieldname": "membership_discount",
   "fieldtype": "Currency",
   "label": "Membership Discount",
   "default": "0",
   "read_only": 1,
   "description": "Sum of per-line category benefits — see Membership Saving Entry for the rule-by-rule breakdown"
  },
  {
   "fieldname": "section_erpnext_sync",
   "fieldtype": "Section Break",
   "label": "ERPNext Sync",
   "collapsible": 1
  },
  {
   "fieldname": "erpnext_customer",
   "fieldtype": "Data",
   "label": "ERPNext Customer",
   "read_only": 1,
   "description": "Customer name in the linked ERPNext site (set by daily sync)"
  },
  {
   "fieldname": "erpnext_sales_order",
   "fieldtype": "Data",
   "label": "ERPNext Sales Order",
   "read_only": 1,
   "description": "Sales Order name in the linked ERPNext site (set by daily sync)"
  },
  {
   "fieldname": "col_break_erpnext",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "erpnext_sales_invoice",
   "fieldtype": "Data",
   "label": "ERPNext Sales Invoice",
   "read_only": 1,
   "description": "Sales Invoice name in the linked ERPNext site (set by daily sync)"
  },
  {
   "fieldname": "erpnext_sync_status",
   "fieldtype": "Select",
   "label": "ERPNext Sync Status",
   "options": "\nPending\nSynced\nFailed\nSkipped",
   "default": "",
   "read_only": 1,
   "description": "Status of the last daily sync attempt for this order"
  },
  {
   "fieldname": "erpnext_sync_error",
   "fieldtype": "Small Text",
   "label": "ERPNext Sync Error",
   "read_only": 1,
   "description": "Error message from the last failed sync attempt"
  },
  {
   "fieldname": "erpnext_synced_at",
   "fieldtype": "Datetime",
   "label": "ERPNext Synced At",
   "read_only": 1
  }
 ],
 "search_fields": "customer_name,customer_email,customer_phone",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "SM Vendor",
   "read": 1,
   "write": 1
  },
  {
   "role": "SM Customer",
   "read": 1,
   "create": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [],
 "states": [],
 "naming_rule": "Expression (old style)",
 "field_order": [
  "customer_name",
  "customer_email",
  "customer_phone",
  "col_break_1",
  "status",
  "payment_status",
  "payment_method",
  "section_items",
  "items",
  "section_fulfillments",
  "vendor_fulfillments",
  "section_amounts",
  "subtotal",
  "net_total",
  "taxes",
  "total_taxes",
  "delivery_charge",
  "free_delivery",
  "discount_amount",
  "total_discount",
  "col_break_2",
  "grand_total",
  "section_delivery",
  "delivery_zone",
  "delivery_address",
  "delivery_lat",
  "delivery_lng",
  "section_vendor",
  "vendor",
  "vendor_order_id",
  "section_meta",
  "notes",
  "section_payment_detail",
  "payment_reference",
  "esewa_transaction_uid",
  "section_loyalty",
  "loyalty_points_redeemed",
  "loyalty_discount",
  "col_break_loyalty",
  "loyalty_points_earned",
  "coupon_code",
  "coupon_discount",
  "onboarding_discount",
  "onboarding_order_sequence",
  "membership",
  "membership_discount",
  "section_erpnext_sync",
  "erpnext_customer",
  "erpnext_sales_order",
  "col_break_erpnext",
  "erpnext_sales_invoice",
  "erpnext_sync_status",
  "erpnext_sync_error",
  "erpnext_synced_at"
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}