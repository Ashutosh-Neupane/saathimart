{
 "name": "Popular Location",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-LOC-.#####",
 "fields": [
  {"fieldname": "location_name", "fieldtype": "Data", "label": "Location Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "unique": 1, "reqd": 1, "in_list_view": 1,
   "description": "URL-safe key, e.g. 'new-baneshwor'."},
  {"fieldname": "city", "fieldtype": "Data", "label": "City", "reqd": 1, "in_list_view": 1},
  {"fieldname": "district", "fieldtype": "Data", "label": "District"},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
  {"fieldname": "latitude", "fieldtype": "Float", "label": "Latitude", "reqd": 1, "precision": "6"},
  {"fieldname": "longitude", "fieldtype": "Float", "label": "Longitude", "reqd": 1, "precision": "6"},
  {"fieldname": "section_display", "fieldtype": "Section Break", "label": "Display"},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0", "in_list_view": 1},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": "1", "in_list_view": 1}
 ],
 "title_field": "location_name",
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Guest", "read": 1}
 ]
}
