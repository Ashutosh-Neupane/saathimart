{
  "name": "Product",
  "module": "Saathimart",
  "doctype": "DocType",
  "autoname": "field:product_name",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "product_name", "fieldtype": "Data", "label": "Product Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "unique": 1},
    {"fieldname": "category", "fieldtype": "Link", "label": "Category", "options": "Category", "in_list_view": 1},
    {"fieldname": "brand", "fieldtype": "Data", "label": "Brand"},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nActive\nInactive\nOut of Stock", "default": "Draft", "in_list_view": 1},
    {"fieldname": "section_general", "fieldtype": "Section Break", "label": "General"},
    {"fieldname": "short_description", "fieldtype": "Small Text", "label": "Short Description"},
    {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description"},
    {"fieldname": "specifications", "fieldtype": "Table", "label": "Specifications", "options": "Product Specification"},
    {"fieldname": "section_media", "fieldtype": "Section Break", "label": "Media"},
    {"fieldname": "media", "fieldtype": "Table", "label": "Media", "options": "Product Media"},
    {"fieldname": "thumbnail", "fieldtype": "Data", "label": "Thumbnail"},
    {"fieldname": "section_meta", "fieldtype": "Section Break", "label": "SEO"},
    {"fieldname": "meta_title", "fieldtype": "Data", "label": "Meta Title"},
    {"fieldname": "meta_description", "fieldtype": "Small Text", "label": "Meta Description"},
    {"fieldname": "tags", "fieldtype": "Data", "label": "Tags (comma separated)"},
     {"fieldname": "section_vendor_listings", "fieldtype": "Section Break", "label": "Vendor Listings"},
     {"fieldname": "section_pricing", "fieldtype": "Section Break", "label": "Pricing"},
     {"fieldname": "prices", "fieldtype": "Table", "label": "Prices", "options": "Product Price"},
     {"fieldname": "display_price", "fieldtype": "Currency", "label": "Display Price", "read_only": 1,
      "description": "Cached cheapest active Vendor Listing price — kept in sync automatically whenever any Vendor Listing for this product changes (see saathimart.events.publisher.on_vendor_listing_changed). For fast list/browse reads only (homepage rails, search results); checkout and the product detail page still resolve the real per-vendor price from Vendor Listing directly, never this cache."},
     {"fieldname": "display_compare_price", "fieldtype": "Currency", "label": "Display Compare Price", "read_only": 1},
     {"fieldname": "section_inventory", "fieldtype": "Section Break", "label": "Inventory"},
     {"fieldname": "sku", "fieldtype": "Data", "label": "SKU"},
     {"fieldname": "track_inventory", "fieldtype": "Check", "label": "Track Inventory", "default": 1},
     {"fieldname": "stock_qty", "fieldtype": "Float", "label": "Stock Qty", "default": "0", "read_only": 1},
     {"fieldname": "section_rating", "fieldtype": "Section Break", "label": "Ratings"},
    {"fieldname": "avg_rating", "fieldtype": "Float", "label": "Avg Rating", "default": "0", "read_only": 1, "in_list_view": 1},
    {"fieldname": "review_count", "fieldtype": "Int", "label": "Review Count", "default": "0", "read_only": 1, "in_list_view": 1}
  ],
  "title_field": "product_name",
  "search_fields": "product_name,slug",
  "permissions": [
    {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "SM Vendor", "read": 1, "write": 1, "create": 1},
    {"role": "Guest", "read": 1}
  ]
}
