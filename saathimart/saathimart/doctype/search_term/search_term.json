{
  "name": "Search Term",
  "module": "Saathimart",
  "doctype": "DocType",
  "autoname": "field:search_key",
  "naming_rule": "By fieldname",
  "fields": [
    {"fieldname": "search_term", "fieldtype": "Data", "label": "Search Term", "reqd": 1, "in_list_view": 1,
     "description": "As the shopper typed it — this is what get_top_searches shows."},
    {"fieldname": "search_key", "fieldtype": "Data", "label": "Search Key", "reqd": 1, "unique": 1,
     "description": "Lowercased, whitespace-collapsed form. The dedupe key, so 'Fresh  Milk' and 'fresh milk' are one row."},
    {"fieldname": "column_break_main", "fieldtype": "Column Break"},
    {"fieldname": "search_count", "fieldtype": "Int", "label": "Search Count", "default": "0", "in_list_view": 1},
    {"fieldname": "last_result_count", "fieldtype": "Int", "label": "Last Result Count", "in_list_view": 1,
     "description": "Results the most recent search returned. A popular term sitting at 0 is a catalog gap worth filling."},
    {"fieldname": "last_searched_at", "fieldtype": "Datetime", "label": "Last Searched At"}
  ],
  "title_field": "search_term",
  "sort_field": "search_count",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "permissions": [
    {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
