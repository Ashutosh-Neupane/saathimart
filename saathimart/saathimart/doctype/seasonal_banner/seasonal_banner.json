{
  "name": "Seasonal Banner",
  "module": "Saathimart",
  "doctype": "DocType",
  "autoname": "field:slide_key",
  "fields": [
    {"fieldname": "slide_key", "fieldtype": "Data", "label": "Banner Key", "reqd": 1, "unique": 1, "in_list_view": 1,
     "description": "Frontend banner id, e.g. dashain, tihar"},
    {"fieldname": "section_content", "fieldtype": "Section Break", "label": "Content"},
    {"fieldname": "title_lines", "fieldtype": "Small Text", "label": "Title Lines",
     "description": "One line per row for multi-line banner title"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "image", "fieldtype": "Attach Image", "label": "Image"},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "cta_label", "fieldtype": "Data", "label": "CTA Label"},
    {"fieldname": "cta_href", "fieldtype": "Data", "label": "CTA URL",
     "description": "Internal path only"},
    {"fieldname": "section_meta", "fieldtype": "Section Break", "label": "Meta"},
    {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0"},
    {"fieldname": "published", "fieldtype": "Check", "label": "Published", "default": "1"}
  ],
  "title_field": "slide_key",
  "permissions": [
    {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Website Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Guest", "read": 1}
  ]
}
