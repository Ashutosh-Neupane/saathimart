{
 "name": "Site Page",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "SM-PAGE-.#####",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "slug",
   "fieldtype": "Data",
   "label": "Slug",
   "unique": 1,
   "reqd": 1
  },
  {
   "fieldname": "page_type",
   "fieldtype": "Select",
   "label": "Page Type",
   "options": "Custom\nHome\nShop\nAbout\nContact\nLegal\nBlog",
   "default": "Custom",
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPublished\nArchived",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "published_at",
   "fieldtype": "Datetime",
   "label": "Published At"
  },
  {
   "fieldname": "section_header",
   "fieldtype": "Section Break",
   "label": "Header"
  },
  {
   "fieldname": "breadcrumb_label",
   "fieldtype": "Data",
   "label": "Breadcrumb Label",
   "description": "Short uppercase label shown in the breadcrumb, e.g. \"ABOUT US\""
  },
  {
   "fieldname": "subtitle",
   "fieldtype": "Data",
   "label": "Subtitle"
  },
  {
   "fieldname": "section_seo",
   "fieldtype": "Section Break",
   "label": "SEO"
  },
  {
   "fieldname": "meta_title",
   "fieldtype": "Data",
   "label": "Meta Title"
  },
  {
   "fieldname": "meta_description",
   "fieldtype": "Small Text",
   "label": "Meta Description"
  },
  {
   "fieldname": "og_image",
   "fieldtype": "Attach Image",
   "label": "OG Image"
  },
  {
   "fieldname": "section_blocks",
   "fieldtype": "Section Break",
   "label": "Sections (JSON)"
  },
  {
   "fieldname": "sections",
   "fieldtype": "Code",
   "label": "Sections",
   "options": "JSON",
   "description": "JSON array of structured content sections: paragraph/heading/list/cta blocks, matching the frontend's PageSection contract exactly (no raw HTML)."
  }
 ],
 "title_field": "title",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Guest",
   "read": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [],
 "states": [],
 "naming_rule": "Expression (old style)",
 "field_order": [
  "title",
  "slug",
  "page_type",
  "col_break_1",
  "status",
  "published_at",
  "section_header",
  "breadcrumb_label",
  "subtitle",
  "section_seo",
  "meta_title",
  "meta_description",
  "og_image",
  "section_blocks",
  "sections"
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}