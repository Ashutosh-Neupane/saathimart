{
 "name": "SM Feature Flag",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "field:feature_name",
 "naming_rule": "By fieldname",
 "engine": "InnoDB",
 "description": "Feature flags for gradual rollout and A/B testing",
 "field_order": [
  "feature_name",
  "feature_key",
  "description",
  "is_active",
  "column_break_1",
  "rollout_percentage",
  "enabled_for_users",
  "start_date",
  "end_date",
  "condition"
 ],
 "fields": [
  {"fieldname": "feature_name", "fieldtype": "Data", "label": "Feature Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "feature_key", "fieldtype": "Data", "label": "Feature Key", "reqd": 1, "unique": 1, "description": "Unique key for programmatic access"},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": "0"},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "rollout_percentage", "fieldtype": "Int", "label": "Rollout Percentage", "default": "100", "description": "Percentage of users to enable this feature for (0-100)"},
  {"fieldname": "enabled_for_users", "fieldtype": "Table MultiSelect", "label": "Enabled for Users", "options": "SM Feature Flag User"},
  {"fieldname": "start_date", "fieldtype": "Datetime", "label": "Start Date"},
  {"fieldname": "end_date", "fieldtype": "Datetime", "label": "End Date"},
  {"fieldname": "condition", "fieldtype": "Small Text", "label": "Condition", "description": "Safe condition expression", "default": "True"}
 ],
 "title_field": "feature_name",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [],
 "states": [],
 "permissions": [
  {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "email": 1, "print": 1, "share": 1}
 ]
}
