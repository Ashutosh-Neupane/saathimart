{
 "name": "Vendor",
 "module": "Saathimart",
 "doctype": "DocType",
 "fields": [
  {
   "fieldname": "vendor_name",
   "fieldtype": "Data",
   "label": "Vendor Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "slug",
   "fieldtype": "Data",
   "label": "Slug",
   "unique": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending\nActive\nSuspended",
   "default": "Pending",
   "in_list_view": 1
  },
  {
   "fieldname": "delivery_zone",
   "fieldtype": "Link",
   "label": "Default Delivery Zone",
   "options": "Delivery Zone"
  },
  {
   "fieldname": "section_connection",
   "fieldtype": "Section Break",
   "label": "🔗 Connection"
  },
  {
   "fieldname": "frappe_site_url",
   "fieldtype": "Data",
   "label": "Frappe Site URL",
   "description": "Full URL of the vendor's Frappe site, e.g. http://vendor1.example.com:8000. The hostname portion is sent as the Host header so the hub reaches the right site on a multi-tenant vendor bench (a bare container/service name cannot route)."
  },
  {
   "fieldname": "api_key",
   "fieldtype": "Data",
   "label": "API Key"
  },
  {
   "fieldname": "col_break_conn",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "api_secret",
   "fieldtype": "Password",
   "label": "API Secret"
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "description": "Per-vendor HMAC secret for inbound webhook authentication. Leave blank to use the global Settings secret."
  },
  {
   "fieldname": "section_commission",
   "fieldtype": "Section Break",
   "label": "💰 Commission & TDS"
  },
  {
   "fieldname": "commission_pct",
   "fieldtype": "Float",
   "label": "SaathiMart Commission %",
   "default": "10",
   "non_negative": 1,
   "description": "Commission this vendor pays the platform on hub orders (agreed contract rate). Settlements and payout math read this via saathimart.api.commission."
  },
  {
   "fieldname": "tds_rate",
   "fieldtype": "Float",
   "label": "TDS Rate on Commission %",
   "default": "15",
   "non_negative": 1,
   "description": "Withholding applied to the commission under Income Tax Act 2058 s88 — the vendor deposits it with IRD and certifies it to the platform."
  },
  {
   "fieldname": "col_break_commission",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "commission_effective_note",
   "fieldtype": "Small Text",
   "label": "Notes",
   "description": "Optional contract notes: effective date, negotiated rate, certificate cadence."
  },
  {
   "fieldname": "section_webhook_meta",
   "fieldtype": "Section Break",
   "label": "🌐 Webhook Sync State"
  },
  {
   "fieldname": "webhook_secret_old",
   "fieldtype": "Password",
   "label": "Previous Webhook Secret",
   "description": "Accepted (never sent) during rotation so the secret can be swapped with zero downtime."
  },
  {
   "fieldname": "webhook_secret_rotated_at",
   "fieldtype": "Datetime",
   "label": "Webhook Secret Last Rotated",
   "read_only": 1,
   "description": "Set by api/secret_rotation.py:rotate_vendor_secret on success. Blank means never rotated since this field was added — api/secret_rotation.py:check_stale_secrets treats that as due, using the vendor's creation date as the baseline."
  },
  {
   "fieldname": "col_break_whmeta",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "last_event_seq",
   "fieldtype": "Int",
   "label": "Last Event Seq",
   "read_only": 1,
   "description": "Last event sequence number delivered to this vendor for idempotency"
  },
  {
   "fieldname": "last_processed_event_seq",
   "fieldtype": "Int",
   "label": "Last Processed Event Seq",
   "read_only": 1,
   "description": "Highest event_seq successfully delivered to this vendor, in order. Used to hold later-sequenced events until earlier gaps are filled — see api/event_ordering.py."
  },
  {
   "fieldname": "section_sync_health",
   "fieldtype": "Section Break",
   "label": "💓 Sync Health"
  },
  {
   "fieldname": "clock_skew_seconds",
   "fieldtype": "Float",
   "label": "Clock Skew (seconds)",
   "read_only": 1,
   "description": "Measured difference between this vendor's clock and the hub's, from inbound request timestamps. Positive = vendor ahead. Widens the HMAC timestamp tolerance for this vendor — see api/clock_sync.py."
  },
  {
   "fieldname": "error_count",
   "fieldtype": "Int",
   "label": "Error Count (DB Fallback)",
   "read_only": 1,
   "description": "Delivery error counter used only when Redis is unavailable — see api/partial_failure.py._db_record_error. Not the live error-budget counter (that lives in cache)."
  },
  {
   "fieldname": "col_break_health",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "hub_status",
   "fieldtype": "Select",
   "label": "Hub Status",
   "options": "Active\nUnreachable\nSuspended",
   "default": "Active",
   "read_only": 1
  },
  {
   "fieldname": "last_sync_at",
   "fieldtype": "Datetime",
   "label": "Last Stock Sync At",
   "read_only": 1
  },
  {
   "fieldname": "section_contact",
   "fieldtype": "Section Break",
   "label": "📞 Contact"
  },
  {
   "fieldname": "contact_email",
   "fieldtype": "Data",
   "label": "Contact Email",
   "options": "Email"
  },
  {
   "fieldname": "contact_phone",
   "fieldtype": "Data",
   "label": "Contact Phone"
  },
  {
   "fieldname": "col_break_contact",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "address",
   "fieldtype": "Small Text",
   "label": "Address"
  },
  {
   "fieldname": "section_location",
   "fieldtype": "Section Break",
   "label": "📍 Location & Delivery"
  },
  {
   "fieldname": "lat",
   "fieldtype": "Float",
   "label": "Latitude"
  },
  {
   "fieldname": "lng",
   "fieldtype": "Float",
   "label": "Longitude"
  },
  {
   "fieldname": "col_break_loc",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "service_radius_km",
   "fieldtype": "Float",
   "label": "Service Radius (km)",
   "default": "5"
  },
  {
   "fieldname": "section_stock",
   "fieldtype": "Section Break",
   "label": "📦 Stock & Location"
  },
  {
   "fieldname": "warehouses",
   "fieldtype": "Table",
   "label": "Warehouses",
   "description": "Physical warehouse locations for this vendor. Used for multi-location stock and nearest-warehouse routing.",
   "options": "Vendor Warehouse"
  },
  {
   "fieldname": "total_available_qty",
   "fieldtype": "Float",
   "label": "Total Available Qty (All Products)",
   "read_only": 1
  },
  {
   "fieldname": "col_break_wh",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_warehouse_name",
   "fieldtype": "Data",
   "label": "Default Warehouse Name",
   "description": "Read-only: auto-populated from the warehouse marked as default. Fallback when no warehouse is specified.",
   "read_only": 1
  },
  {
   "fieldname": "total_physical_qty",
   "fieldtype": "Float",
   "label": "Total Physical Qty (All Products)",
   "read_only": 1
  },
  {
   "fieldname": "section_credentials_info",
   "fieldtype": "Section Break",
   "label": "🔐 Credentials Info"
  },
  {
   "fieldname": "credentials_info",
   "fieldtype": "Small Text",
   "label": "Setup Instructions",
   "read_only": 1,
   "description": "Auto-generated on creation. Copy these values to the vendor's Frappe site: Site URL, API Key, API Secret, and Webhook Secret."
  },
  {
   "fieldname": "section_meta",
   "fieldtype": "Section Break",
   "label": "ℹ️ Meta"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "tab_sync_health",
   "fieldtype": "Tab Break",
   "label": "Sync Health",
   "options": "fa fa-heartbeat"
  },
  {
   "fieldname": "tab_location_stock",
   "fieldtype": "Tab Break",
   "label": "Location & Stock",
   "options": "fa fa-map-marker"
  },
  {
   "fieldname": "tab_more_info",
   "fieldtype": "Tab Break",
   "label": "More Info",
   "options": "fa fa-file-text"
  },
  {
   "fieldname": "tab_connections",
   "fieldtype": "Tab Break",
   "label": "Connections",
   "show_dashboard": 1
  },
  {
   "fieldname": "section_reconciliation",
   "fieldtype": "Section Break",
   "label": "Stock Reconciliation"
  },
  {
   "fieldname": "reconciliation_enabled",
   "fieldtype": "Check",
   "label": "Hourly Reconciliation Enabled",
   "default": "1",
   "description": "Hub-side safety net: hourly comparison of this vendor's real ERPNext stock against Vendor Stock, independent of the vendor's own reconciliation job (if they run one)."
  },
  {
   "fieldname": "col_break_recon",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reconciliation_threshold_pct",
   "fieldtype": "Float",
   "label": "Drift Threshold (%)",
   "default": "5",
   "description": "Auto-correct silently within this percentage drift; beyond it, flag for review instead."
  },
  {
   "fieldname": "tab_accounting",
   "fieldtype": "Tab Break",
   "label": "Accounting"
  },
  {
   "fieldname": "section_accounts",
   "fieldtype": "Section Break",
   "label": "GL Account Overrides"
  },
  {
   "fieldname": "accounts_help",
   "fieldtype": "HTML",
   "options": "<p>Optional per-vendor GL account names for the vendor's own ERPNext books. Left blank, accounts resolve by standard name / fuzzy match on the vendor site. Set these when the vendor's Chart of Accounts uses non-standard names — unresolvable accounts now fail LOUD instead of posting unbalanced GL.</p><p><b>Push to vendor site:</b> copy these keys into Vendor Config → Account Overrides (JSON) on the vendor's Frappe site.</p>"
  },
  {
   "fieldname": "acct_cash_bank",
   "fieldtype": "Data",
   "label": "Cash / Bank",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_revenue",
   "fieldtype": "Data",
   "label": "Revenue (Sales)",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_vat_output",
   "fieldtype": "Data",
   "label": "VAT Output",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_vat_input",
   "fieldtype": "Data",
   "label": "VAT Input",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_clearing_platform",
   "fieldtype": "Data",
   "label": "SaathiMart Clearing",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_tds_payable",
   "fieldtype": "Data",
   "label": "TDS Payable",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_commission_expense",
   "fieldtype": "Data",
   "label": "Commission Expense",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_platform_coupon_income",
   "fieldtype": "Data",
   "label": "Platform Coupon Reimbursement",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_loyalty_income",
   "fieldtype": "Data",
   "label": "Loyalty Reimbursement",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_accounts_receivable",
   "fieldtype": "Data",
   "label": "Accounts Receivable",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "acct_accounts_payable",
   "fieldtype": "Data",
   "label": "Accounts Payable",
   "depends_on": "eval:doc.acct_revenue || doc.acct_clearing_platform || 1"
  },
  {
   "fieldname": "col_break_acct",
   "fieldtype": "Column Break"
  }
 ],
 "title_field": "vendor_name",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "SM Vendor",
   "read": 1,
   "write": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
