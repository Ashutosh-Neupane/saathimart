{
  "name": "Vendor",
  "module": "Saathimart",
  "doctype": "DocType",
  "fields": [
    {"fieldname": "vendor_name", "fieldtype": "Data", "label": "Vendor Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "unique": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nActive\nSuspended", "default": "Pending", "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "frappe_site_url", "fieldtype": "Data", "label": "Frappe Site URL"},
    {"fieldname": "api_key", "fieldtype": "Data", "label": "API Key"},
    {"fieldname": "api_secret", "fieldtype": "Password", "label": "API Secret"},
     {"fieldname": "last_event_seq", "fieldtype": "Int", "label": "Last Event Seq", "read_only": 1,
      "description": "Last event sequence number delivered to this vendor for idempotency"},
     {"fieldname": "webhook_secret", "fieldtype": "Password", "label": "Webhook Secret",
      "description": "Per-vendor HMAC secret for inbound webhook authentication. Leave blank to use the global Settings secret."},
     {"fieldname": "section_contact", "fieldtype": "Section Break", "label": "Contact"},
    {"fieldname": "contact_email", "fieldtype": "Data", "label": "Contact Email", "options": "Email"},
    {"fieldname": "contact_phone", "fieldtype": "Data", "label": "Contact Phone"},
    {"fieldname": "address", "fieldtype": "Small Text", "label": "Address"},
    {"fieldname": "section_delivery", "fieldtype": "Section Break", "label": "Delivery"},
    {"fieldname": "delivery_zone", "fieldtype": "Link", "label": "Default Delivery Zone", "options": "Delivery Zone"},
    {"fieldname": "commission_pct", "fieldtype": "Float", "label": "Commission %", "default": "0"},
    {"fieldname": "section_stock", "fieldtype": "Section Break", "label": "Stock & Location"},
    {"fieldname": "lat", "fieldtype": "Float", "label": "Latitude"},
    {"fieldname": "lng", "fieldtype": "Float", "label": "Longitude"},
    {"fieldname": "service_radius_km", "fieldtype": "Float", "label": "Service Radius (km)", "default": "5"},
    {"fieldname": "default_warehouse", "fieldtype": "Link", "label": "Default Warehouse", "options": "Warehouse"},
    {"fieldname": "total_available_qty", "fieldtype": "Float", "label": "Total Available Qty (All Products)", "read_only": 1},
    {"fieldname": "total_physical_qty", "fieldtype": "Float", "label": "Total Physical Qty (All Products)", "read_only": 1},
    {"fieldname": "last_sync_at", "fieldtype": "Datetime", "label": "Last Stock Sync At", "read_only": 1},
    {"fieldname": "hub_status", "fieldtype": "Select", "label": "Hub Status", "options": "Active\nUnreachable\nSuspended", "default": "Active", "read_only": 1},
    {"fieldname": "section_meta", "fieldtype": "Section Break", "label": "Meta"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "title_field": "vendor_name",
  "permissions": [
    {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "SM Vendor", "read": 1, "write": 1}
  ]
}
