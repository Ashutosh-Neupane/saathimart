{
 "name": "Vendor Listing",
 "module": "Saathimart",
 "doctype": "DocType",
 "autoname": "VL-.{vendor}-.{product}",
 "fields": [
  {
   "fieldname": "vendor",
   "fieldtype": "Link",
   "label": "Vendor",
   "options": "Vendor",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "label": "Product",
   "options": "Product",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nInactive\nOut of Stock",
   "default": "Active",
   "in_list_view": 1
  },
  {
   "fieldname": "price",
   "fieldtype": "Currency",
   "label": "Selling Price",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "compare_price",
   "fieldtype": "Currency",
   "label": "MRP / Compare Price"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "barcode",
   "fieldtype": "Data",
   "label": "Barcode",
   "description": "Physical barcode on the product — used for lookup by vendors"
  },
  {
   "fieldname": "sku",
   "fieldtype": "Data",
   "label": "Vendor SKU",
   "description": "Vendor's internal stock-keeping unit code"
  },
  {
   "fieldname": "vendor_product_id",
   "fieldtype": "Data",
   "label": "Vendor Product ID"
  },
  {
   "fieldname": "section_inventory",
   "fieldtype": "Section Break",
   "label": "📦 Inventory"
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Data",
   "label": "Warehouse",
   "description": "Warehouse identifier for this listing. Links to Vendor Warehouse on multi-location vendors."
  },
  {
   "fieldname": "track_inventory",
   "fieldtype": "Check",
   "label": "Track Inventory",
   "default": "1"
  },
  {
   "fieldname": "allow_backorder",
   "fieldtype": "Check",
   "label": "Allow Backorder",
   "default": "0"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "section_delivery",
   "fieldtype": "Section Break",
   "label": "🚚 Delivery"
  },
  {
   "fieldname": "delivery_zone",
   "fieldtype": "Link",
   "label": "Delivery Zone",
   "options": "Delivery Zone"
  },
  {
   "fieldname": "estimated_delivery_minutes",
   "fieldtype": "Int",
   "label": "Est. Delivery (minutes)",
   "default": "20"
  },
  {
   "fieldname": "priority",
   "fieldtype": "Int",
   "label": "Priority",
   "default": "0",
   "description": "Higher = preferred when all else is equal"
  },
  {
   "fieldname": "section_sync",
   "fieldtype": "Section Break",
   "label": "🔄 Sync"
  },
  {
   "fieldname": "sync_enabled",
   "fieldtype": "Check",
   "label": "Enable Sync to Vendor",
   "default": "0",
   "description": "When checked, price/stock changes are pushed to the vendor site automatically. Requires barcode to be set."
  },
  {
   "fieldname": "sync_status",
   "fieldtype": "Select",
   "label": "Sync Status",
   "options": "Pending\nSynced\nFailed",
   "default": "Pending",
   "read_only": 1
  },
  {
   "fieldname": "pushed_at",
   "fieldtype": "Datetime",
   "label": "Pushed At",
   "read_only": 1,
   "description": "Last time this listing was synced to the vendor site"
  },
  {
   "fieldname": "last_sync_at",
   "fieldtype": "Datetime",
   "label": "Last Sync At",
   "read_only": 1
  },
  {
   "fieldname": "last_event_id",
   "fieldtype": "Data",
   "label": "Last Event ID",
   "read_only": 1,
   "description": "UUID of the last processed price.update event for idempotency"
  },
  {
   "fieldname": "last_event_seq",
   "fieldtype": "Int",
   "label": "Last Event Seq",
   "read_only": 1,
   "description": "Monotonically increasing sequence of the last processed price.update event — same pattern as Vendor Stock.last_event_seq"
  },
  {
   "fieldname": "tab_connections",
   "fieldtype": "Tab Break",
   "label": "Connections",
   "show_dashboard": 1
  },
  {
   "fieldname": "tab_fulfillment",
   "fieldtype": "Tab Break",
   "label": "Fulfillment"
  },
  {
   "fieldname": "tab_sync",
   "fieldtype": "Tab Break",
   "label": "Sync"
  }
 ],
 "title_field": "product",
 "permissions": [
  {
   "role": "SM Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "SM Vendor",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Guest",
   "read": 1
  }
 ],
 "engine": "InnoDB",
 "allow_rename": 0,
 "index_web_pages_for_search": 0,
 "actions": [],
 "links": [
  {
   "link_doctype": "Order Item",
   "link_fieldname": "vendor_listing"
  }
 ],
 "states": [],
 "naming_rule": "Expression (old style)",
 "field_order": [
  "vendor",
  "product",
  "col_break_1",
  "status",
  "price",
  "compare_price",
  "col_break_2",
  "barcode",
  "sku",
  "vendor_product_id",
  "tab_fulfillment",
  "section_inventory",
  "warehouse",
  "track_inventory",
  "allow_backorder",
  "section_delivery",
  "delivery_zone",
  "estimated_delivery_minutes",
  "priority",
  "tab_sync",
  "section_sync",
  "sync_enabled",
  "sync_status",
  "pushed_at",
  "last_sync_at",
  "last_event_id",
  "last_event_seq",
  "tab_connections"
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 0,
 "description": "The marketplace sell offer: one row per vendor x product. The SOURCE OF TRUTH for storefront pricing, cart, and checkout — Product.display_price is a denormalized cache of the cheapest active listing (kept in sync by on_vendor_listing_changed). Product Price (child table on Product) is the vendor-neutral default price ladder used only when no listing matches. Stock truth lives in Vendor Stock; this row's qty column is display-only."
}