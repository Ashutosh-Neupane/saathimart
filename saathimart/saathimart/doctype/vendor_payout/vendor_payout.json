{
  "name": "Vendor Payout",
  "module": "Saathimart",
  "doctype": "DocType",
  "autoname": "format:VPOUT-{vendor}-{#####}",
  "track_changes": 1,
  "fields": [
    {"fieldname": "vendor", "fieldtype": "Link", "label": "Vendor", "options": "Vendor", "reqd": 1, "in_list_view": 1},
    {"fieldname": "vendor_name", "fieldtype": "Data", "label": "Vendor Name", "read_only": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nApproved\nPaid\nCancelled", "default": "Draft", "in_list_view": 1},
    {"fieldname": "period_start", "fieldtype": "Date", "label": "Period Start", "reqd": 1},
    {"fieldname": "period_end", "fieldtype": "Date", "label": "Period End", "reqd": 1},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "total_sales", "fieldtype": "Currency", "label": "Total Sales", "read_only": 1, "description": "Sum of delivered order subtotals for this vendor in the period"},
    {"fieldname": "commission_pct", "fieldtype": "Float", "label": "Commission %", "read_only": 1, "description": "Commission percentage from Vendor.doctype"},
    {"fieldname": "commission_amount", "fieldtype": "Currency", "label": "Commission Amount", "read_only": 1},
    {"fieldname": "payout_amount", "fieldtype": "Currency", "label": "Payout Amount", "read_only": 1, "description": "Total Sales - Commission"},
    {"fieldname": "section_orders", "fieldtype": "Section Break", "label": "Included Orders"},
    {"fieldname": "orders", "fieldtype": "Table", "label": "Orders", "options": "Vendor Payout Order"},
    {"fieldname": "section_payment", "fieldtype": "Section Break", "label": "Payment"},
    {"fieldname": "payment_method", "fieldtype": "Data", "label": "Payment Method"},
    {"fieldname": "payment_reference", "fieldtype": "Data", "label": "Payment Reference"},
    {"fieldname": "paid_at", "fieldtype": "Datetime", "label": "Paid At"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "created_by", "fieldtype": "Link", "label": "Created By", "options": "User", "read_only": 1}
  ],
  "permissions": [
    {"role": "SM Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "SM Vendor", "read": 1}
  ]
}
